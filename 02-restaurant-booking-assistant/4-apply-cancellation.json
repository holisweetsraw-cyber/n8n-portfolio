    {
      "parameters": {
        "jsCode": "const b = $input.item.json;\nconst visitDateTime = new Date(`${b.date}T${b.time}:00`);\nconst now = new Date();\nconst hoursUntilVisit = (visitDateTime.getTime() - now.getTime()) / 3600000;\nconst onTime = hoursUntilVisit > 3;\nconst depositPaid = b.deposit_status === 'paid';\nconst partySize = Number(b.party_size || 0);\nlet branch;\nif (onTime && depositPaid) branch = 'on_time_refund_due';\nelse if (onTime && !depositPaid) branch = 'on_time_no_deposit';\nelse if (!onTime && partySize >= 8 && depositPaid) branch = 'late_deposit_forfeit';\nelse branch = 'late_no_deposit';\nreturn [{ json: { ...b, hoursUntilVisit, onTime, depositPaid, branch } }];\n"
      },
