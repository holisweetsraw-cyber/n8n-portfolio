{
  "name": "Basilik — Workflow 3 (Evaluation)",
  "nodes": [
    {
      "parameters": {
        "content": "Workflow 3 — Evaluation (полностью отдельный, асинхронный). Запускается Schedule Trigger раз в сутки, читает весь conversations_log целиком. Evaluation Agent оценивает final_reply_text по 5 критериям (соответствие, полнота, вежливость, hallucinations, needs_human) → пишет строку в eval_log, где operation_id = conversation_log_id.",
        "height": 316,
        "width": 1372,
        "color": 4
      },
      "id": "f9a627c0-86bd-4c53-b11b-5ba344fd26d9",
      "name": "Sticky_workflow3_purpose",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -256,
        -352
      ]
    },
