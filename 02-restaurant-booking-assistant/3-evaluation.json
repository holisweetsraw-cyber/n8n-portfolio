        "inputSchema": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"title\": \"EvaluationAgentOutput\",\n  \"type\": \"object\",\n  \"required\": [\n    \"relevance_score\",\n    \"completeness_score\",\n    \"politeness_score\",\n    \"hallucination_flag\",\n    \"needs_human_flag\",\n    \"judge_comment\"\n  ],\n  \"properties\": {\n    \"relevance_score\": {\n      \"type\": \"integer\",\n      \"minimum\": 1,\n      \"maximum\": 5\n    },\n    \"completeness_score\": {\n      \"type\": \"integer\",\n      \"minimum\": 1,\n      \"maximum\": 5\n    },\n    \"politeness_score\": {\n      \"type\": \"integer\",\n      \"minimum\": 1,\n      \"maximum\": 5\n    },\n    \"hallucination_flag\": {\n      \"type\": \"boolean\"\n    },\n    \"needs_human_flag\": {\n      \"type\": \"boolean\"\n    },\n    \"judge_comment\": {\n      \"type\": \"string\"\n    }\n  }\n}"
      },
